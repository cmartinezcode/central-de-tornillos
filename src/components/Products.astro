---
import { products } from "../data/products.js";
import ProductCard from "./ProductCard.astro";
---

<section class="bg-slate-50 py-20">
  <div class="mx-auto max-w-7xl px-6">

    <div class="max-w-2xl">
      <span class="text-sm font-bold uppercase tracking-wider text-blue-700">
        Nuestro catálogo
      </span>

      <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">
        Tornillería para cada proyecto
      </h2>

      <p class="mt-4 text-lg leading-8 text-slate-600">
        Referencias seleccionadas para ferreterías, construcción,
        mantenimiento y profesionales.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

      {products.map((product) => (
        <ProductCard product={product} />
      ))}

    </div>

  </div>
</section>